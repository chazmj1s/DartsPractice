<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0-windows10.0.19041.0;net9.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <MauiEnableTizen>false</MauiEnableTizen>
    <WindowsPackageType>None</WindowsPackageType>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DartsPractice</RootNamespace>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Dart Sharp 180</ApplicationTitle>
    <ApplicationId>com.dartspractice.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <UIRequiresFullScreen>true</UIRequiresFullScreen>
    <ApplicationIdGuid>00000000-0000-0000-0000-000000000000</ApplicationIdGuid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.30" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.8" />
    <MauiIcon Include="Resources/AppIcon/appicon.png">
    </MauiIcon>
  </ItemGroup>

</Project>
