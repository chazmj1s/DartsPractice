@* ChalkMark.razor - no conditionals inside SVG *@

<div class="chalk-mark-wrap">
    <!-- Box always shown -->
    <svg class="chalk-svg" viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg">
        <path d="M 6,6 Q 28,4 46,6 Q 48,28 46,46 Q 28,48 6,46 Q 4,28 6,6"
              fill="none" stroke="rgba(255,255,255,0.30)"
              stroke-width="1.8" stroke-linecap="round" />
    </svg>

    <!-- Slash — marks 1+ -->
    @if (Marks >= 1)
    {
        <svg class="chalk-svg chalk-overlay" viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg">
            <path d="M 34,11 Q 28,26 18,41"
                  fill="none" stroke="white" stroke-opacity="0.85"
                  stroke-width="3.5" stroke-linecap="round" />
        </svg>
    }

    <!-- Back slash — marks 2+ -->
    @if (Marks >= 2)
    {
        <svg class="chalk-svg chalk-overlay" viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg">
            <path d="M 17,12 Q 26,26 35,41"
                  fill="none" stroke="white" stroke-opacity="0.85"
                  stroke-width="3.5" stroke-linecap="round" />
        </svg>
    }

    <!-- Circle — marks 3+ -->
    @if (Marks >= 3)
    {
        <svg class="chalk-svg chalk-overlay" viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg">
            <circle cx="26" cy="26" r="13"
                    fill="none" stroke="white" stroke-opacity="0.80"
                    stroke-width="2.8" />
        </svg>
    }
</div>

@code {
    [Parameter, EditorRequired] public int Marks { get; set; }
}
